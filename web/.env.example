NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVER_KEY

# Supabase project URL from the Supabase Dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the project's publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=your-placeholder-publishable-key

# An existing table created by Issue #10 migrations
SUPABASE_TEST_TABLE=customer

SESSION_SECRET=<output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">